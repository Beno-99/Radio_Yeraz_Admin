{
  "version": 3,
  "pages404": true,
  "caseSensitive": false,
  "basePath": "",
  "redirects": [
    {
      "source": "/:path+/",
      "destination": "/:path+",
      "internal": true,
      "statusCode": 308,
      "regex": "^(?:/((?:[^/]+?)(?:/(?:[^/]+?))*))/$"
    }
  ],
  "headers": [],
  "dynamicRoutes": [
    {
      "page": "/dashboard/admin/[id]",
      "regex": "^/dashboard/admin/([^/]+?)(?:/)?$",
      "routeKeys": {
        "nxtPid": "nxtPid"
      },
      "namedRegex": "^/dashboard/admin/(?<nxtPid>[^/]+?)(?:/)?$"
    },
    {
      "page": "/dashboard/admin/[id]/edit",
      "regex": "^/dashboard/admin/([^/]+?)/edit(?:/)?$",
      "routeKeys": {
        "nxtPid": "nxtPid"
      },
      "namedRegex": "^/dashboard/admin/(?<nxtPid>[^/]+?)/edit(?:/)?$"
    },
    {
      "page": "/dashboard/ads/[id]",
      "regex": "^/dashboard/ads/([^/]+?)(?:/)?$",
      "routeKeys": {
        "nxtPid": "nxtPid"
      },
      "namedRegex": "^/dashboard/ads/(?<nxtPid>[^/]+?)(?:/)?$"
    },
    {
      "page": "/dashboard/ads/[id]/edit",
      "regex": "^/dashboard/ads/([^/]+?)/edit(?:/)?$",
      "routeKeys": {
        "nxtPid": "nxtPid"
      },
      "namedRegex": "^/dashboard/ads/(?<nxtPid>[^/]+?)/edit(?:/)?$"
    },
    {
      "page": "/dashboard/posts/[id]",
      "regex": "^/dashboard/posts/([^/]+?)(?:/)?$",
      "routeKeys": {
        "nxtPid": "nxtPid"
      },
      "namedRegex": "^/dashboard/posts/(?<nxtPid>[^/]+?)(?:/)?$"
    },
    {
      "page": "/dashboard/posts/[id]/edit",
      "regex": "^/dashboard/posts/([^/]+?)/edit(?:/)?$",
      "routeKeys": {
        "nxtPid": "nxtPid"
      },
      "namedRegex": "^/dashboard/posts/(?<nxtPid>[^/]+?)/edit(?:/)?$"
    }
  ],
  "staticRoutes": [
    {
      "page": "/",
      "regex": "^/(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/(?:/)?$"
    },
    {
      "page": "/_not-found",
      "regex": "^/_not\\-found(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/_not\\-found(?:/)?$"
    },
    {
      "page": "/dashboard",
      "regex": "^/dashboard(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/dashboard(?:/)?$"
    },
    {
      "page": "/dashboard/admin",
      "regex": "^/dashboard/admin(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/dashboard/admin(?:/)?$"
    },
    {
      "page": "/dashboard/ads",
      "regex": "^/dashboard/ads(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/dashboard/ads(?:/)?$"
    },
    {
      "page": "/dashboard/ads/create",
      "regex": "^/dashboard/ads/create(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/dashboard/ads/create(?:/)?$"
    },
    {
      "page": "/dashboard/notifications",
      "regex": "^/dashboard/notifications(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/dashboard/notifications(?:/)?$"
    },
    {
      "page": "/dashboard/posts",
      "regex": "^/dashboard/posts(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/dashboard/posts(?:/)?$"
    },
    {
      "page": "/dashboard/posts/create",
